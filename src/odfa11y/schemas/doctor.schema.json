{
  "$id": "urn:odfa11y:schema:doctor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exit_status": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "failure": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "details": {
              "type": "string"
            },
            "exit_status": {
              "enum": [
                2,
                3,
                4
              ]
            },
            "message": {
              "type": "string"
            },
            "problems": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "remedy": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "enum": [
                        "regenerate-plan",
                        "rebind-plan",
                        "choose-output",
                        "install-tool",
                        "edit-in-application",
                        "embed-resource"
                      ]
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "target": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "action",
                    "target",
                    "detail"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "exit_status",
            "remedy",
            "problems",
            "details"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "libraries": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "odfa11y": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "python": {
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "schema_versions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "toolchain": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "family": {
                "enum": [
                  "text",
                  "spreadsheet",
                  "presentation",
                  "drawing",
                  "formula",
                  "chart",
                  "image",
                  "database"
                ]
              },
              "id": {
                "enum": [
                  "link-descriptions",
                  "decorative-graphic-role",
                  "writer-header-columns",
                  "math-tagging",
                  "calc-pdfua"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "supported",
                  "unsupported",
                  "not-tested"
                ]
              },
              "tool": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "version"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "family",
              "status",
              "tool",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "libreoffice": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "verapdf": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "libreoffice",
        "verapdf",
        "capabilities"
      ],
      "type": "object"
    }
  },
  "required": [
    "odfa11y",
    "python",
    "platform",
    "libraries",
    "schema_versions",
    "toolchain",
    "schema_version",
    "exit_status",
    "failure"
  ],
  "type": "object"
}
