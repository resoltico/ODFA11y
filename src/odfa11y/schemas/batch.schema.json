{
  "$id": "urn:odfa11y:schema:batch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exit_status": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "details": {
                    "type": "string"
                  },
                  "exit_status": {
                    "enum": [
                      2,
                      3,
                      4
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "problems": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "remedy": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "action": {
                            "enum": [
                              "regenerate-plan",
                              "rebind-plan",
                              "choose-output",
                              "install-tool",
                              "edit-in-application",
                              "embed-resource"
                            ]
                          },
                          "detail": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "target": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "action",
                          "target",
                          "detail"
                        ],
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "exit_status",
                  "remedy",
                  "problems",
                  "details"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_status": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1,
                  2,
                  3,
                  4
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "failed_stage": {
            "anyOf": [
              {
                "enum": [
                  "audit-source",
                  "remediate",
                  "audit-remediated",
                  "export-source",
                  "export-remediated",
                  "audit-pdf",
                  "validate-pdf",
                  "fidelity",
                  "publish-evidence"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          }
        },
        "required": [
          "id",
          "error",
          "evidence",
          "failed_stage",
          "exit_status",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "pending_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile": {
      "enum": [
        "source",
        "pdf",
        "production"
      ]
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  },
  "required": [
    "profile",
    "items",
    "exit_status",
    "status",
    "schema_version",
    "pending_ids"
  ],
  "type": "object"
}
