 <office:meta><dc:title>Footnotes</dc:title><dc:language>en-US</dc:language></office:meta>
 <office:automatic-styles></office:automatic-styles>
 
 <office:body><office:text>
<text:h text:outline-level="1">Footnotes</text:h>
<text:p>The first claim needs support.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>First supporting note.</text:p></text:note-body></text:note> A second claim follows.<text:note text:id="ftn2" text:note-class="footnote"><text:note-citation>2</text:note-citation><text:note-body><text:p>Second supporting note.</text:p></text:note-body></text:note></text:p>
 </office:text></office:body>
</office:document>
