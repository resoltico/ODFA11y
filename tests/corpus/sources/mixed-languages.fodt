<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta><dc:title>Mixed languages</dc:title><dc:language>en-US</dc:language></office:meta>
 <office:automatic-styles><style:style style:name="T1" style:family="text"><style:text-properties fo:language="de" fo:country="DE"/></style:style><style:style style:name="T2" style:family="text"><style:text-properties fo:language="fr" fo:country="FR"/></style:style><style:style style:name="P1" style:family="paragraph"><style:text-properties fo:language="lv" fo:country="LV"/></style:style></office:automatic-styles>
 
 <office:body><office:text>
<text:h text:outline-level="1">Mixed languages</text:h>
<text:p>English text with a German phrase <text:span text:style-name="T1">guten Morgen alle zusammen</text:span> and a French one <text:span text:style-name="T2">bonne journée</text:span>.</text:p>
<text:p text:style-name="P1">Šis ir latviešu teksts.</text:p>
 </office:text></office:body>
</office:document>
